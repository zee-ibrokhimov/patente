# Copy to .env and fill in. NEVER commit .env.

# --- Telegram ---------------------------------------------------------------
# Two separate bots: one for development, one for production (plan §14.6).
BOT_TOKEN_DEV=
BOT_TOKEN_PROD=
BOT_USERNAME=QuizPatenteBot
ENV=dev

# --- Core API ---------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite+aiosqlite:///./patente.db

# --- Content pipeline (offline scripts only, never at runtime) --------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Payments (Tribute) — not needed until build step 9 ---------------------
TRIBUTE_API_KEY=
TRIBUTE_WEBHOOK_SECRET=
TRIBUTE_PRODUCT_1M=
TRIBUTE_PRODUCT_3M=
TRIBUTE_PRODUCT_6M=

# --- Entitlement tuning -----------------------------------------------------
# Lifetime free explanations given as a quality taster (plan §4.3, open decision 5)
FREE_EXPLANATIONS=3

# --- Ops --------------------------------------------------------------------
ADMIN_CHAT_IDS=
# Shown by /support. A @username or an email.
SUPPORT_CONTACT=
