# Backups for the patente database.
#
# The live database is inside the Coolify volume rboj5u2xk5dj4o4yto89ablh_patente-data,
# not on the host filesystem. This job used to point at /srv/patente/patente.db — the
# retired systemd deployment — which meant the real data went unprotected while a backup
# ran green every night against the wrong database. That is the worst shape a backup can
# take, and it is why the script now asserts WHICH database it got rather than only that
# the file is valid SQLite.
#
# HOURLY, not daily. The RPO is the whole point: at daily, a disk failure at 02:00 costs a
# day of progress, entitlement and paid-for generated content. The run takes seconds and
# each snapshot is ~2.7 MB, so the tighter window costs nothing.
#
# Retention is tiered (ops/prune.py): hourly for two days, daily for a month, weekly for a
# quarter, monthly for a year — about 93 files and 250 MB, covering 333 days. Flat
# retention at this cadence would cover two and a half days.
#
# The WATCHDOG is a separate entry running a separate file on purpose: a script that
# alerts on its own failure cannot alert when it never runs at all. Offset to :40 so it
# checks after the hourly run has had time to finish.
#
# Alerts go to Telegram, configured in /etc/patente-backup.env (mode 600, not in git).
# MAILTO is left set but is not the mechanism — postfix here is loopback-only with no
# relayhost and /var/mail has never been written, so cron mail goes nowhere.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=root

0  * * * * root /usr/local/sbin/patente-backup >> /var/log/patente-backup.log 2>&1
40 * * * * root /usr/local/sbin/patente-backup-watchdog >> /var/log/patente-backup.log 2>&1

# "Your Premium ends in 3 days" / "has ended". Was installed on the host and MISSING
# from this file, so a reinstall from the repo would have silently dropped it — the
# renewal warning is the one message this business runs on.
17 * * * * root docker exec $(docker ps -q --filter name=api-rboj5u2xk5dj4o4yto89ablh | head -1) python -c "import urllib.request;print(urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:8000/admin/notify-lapses',method='POST'),timeout=60).read().decode())" >> /var/log/patente-janitor.log 2>&1

# Come-back nudges for learners who have gone quiet. Same shape as the lapse job and
# offset from it, so two docker execs do not start in the same second. Idempotent by
# event, so hourly is harmless — see api/services/reminders.py for the limits.
37 * * * * root docker exec $(docker ps -q --filter name=api-rboj5u2xk5dj4o4yto89ablh | head -1) python -c "import urllib.request;print(urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:8000/admin/notify-quiet',method='POST'),timeout=60).read().decode())" >> /var/log/patente-janitor.log 2>&1

# "Your streak is at risk", to people who have built one and have not banked today. Hourly
# like its neighbours and offset again, but the job REFUSES ITSELF outside 19:00-22:00 Rome
# — the window lives in api/services/streak_nudge.py rather than in this crontab, because a
# cron hour is UTC and Rome moves twice a year. Encoding "19:00 Rome" here would mean the
# message arriving at 18:00 for half the year with nobody having changed anything.
# Idempotent per Rome day from the event log, so a three-hour window sends one message.
53 * * * * root docker exec $(docker ps -q --filter name=api-rboj5u2xk5dj4o4yto89ablh | head -1) python -c "import urllib.request;print(urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:8000/admin/notify-streak-risk',method='POST'),timeout=60).read().decode())" >> /var/log/patente-janitor.log 2>&1

# Trim the league's per-question ledger. Weekly, on Monday morning, just after the season
# rolls over — `league_score` (the totals the board reads) is kept forever, and only the two
# ledgers underneath it are pruned. See api/services/league.py:prune.
17 4 * * 1 root docker exec $(docker ps -q --filter name=api-rboj5u2xk5dj4o4yto89ablh | head -1) python -c "import urllib.request;print(urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:8000/admin/prune-league',method='POST'),timeout=300).read().decode())" >> /var/log/patente-janitor.log 2>&1
